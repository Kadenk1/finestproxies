generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================
// Auth / Users
// =============================================================

enum UserRole {
  CUSTOMER
  SUPPORT
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BANNED
}

model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  passwordHash       String? // null for OAuth-only accounts (e.g. Discord) that never set a password
  name               String?
  companyName        String?
  image              String? // avatar URL from an OAuth provider
  discordId          String?    @unique
  role               UserRole   @default(CUSTOMER)
  status             UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt    DateTime?
  twoFactorEnabled   Boolean    @default(false)
  twoFactorSecretEnc String? // encrypted TOTP secret, never returned via API
  lastLoginAt        DateTime?
  lastLoginIp        String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  sessions           UserSession[]
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  balance            CustomerBalance?
  productBalances    ProductBalance[]
  orders             Order[]
  subscriptions      Subscription[]
  proxyCredentials   CustomerProxyCredential[]
  usageRecords       UsageRecord[]
  supportTickets     SupportTicket[]
  ticketMessages     SupportTicketMessage[]
  accountNotes       AccountNote[]             @relation("AccountNotesForUser")
  authoredNotes      AccountNote[]             @relation("AccountNotesByAuthor")
  auditLogs          AuditLog[]
  abuseReports       AbuseReport[]             @relation("AbuseReportsForUser")

  @@index([role])
  @@index([status])
}

model UserSession {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionJti String    @unique
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ipAddress String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

// =============================================================
// Products / Pricing (admin-managed, no code changes required)
// =============================================================

enum ProductType {
  RESIDENTIAL
  ISP
  MOBILE
}

enum BillingUnit {
  GB
  IP_MONTH
  PORT_MONTH
  FLAT
}

model Product {
  id                   String      @id @default(uuid())
  name                 String
  slug                 String      @unique
  type                 ProductType
  description          String?
  active               Boolean     @default(true)
  retailPrice          Decimal     @db.Decimal(12, 4)
  internalCostEstimate Decimal     @db.Decimal(12, 4)
  billingUnit          BillingUnit
  minPurchase          Decimal     @db.Decimal(12, 4)
  maxPurchase          Decimal     @db.Decimal(12, 4)
  sortOrder            Int         @default(0)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  locations        ProductLocation[]
  gatewayPool      GatewayRoute[]
  providerProducts ProviderProduct[]
  plans            Plan[]
  orderItems       OrderItem[]
  balances         ProductBalance[]
  usageRecords     UsageRecord[]
  proxyCredentials CustomerProxyCredential[]
  subscriptions    Subscription[]

  @@index([type])
  @@index([active])
}

model ProductLocation {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  country   String
  region    String?
  city      String?
  available Boolean @default(true)

  @@unique([productId, country, region, city])
  @@index([productId])
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  ANNUAL
}

model Plan {
  id              String          @id @default(uuid())
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  slug            String          @unique
  billingInterval BillingInterval @default(MONTHLY)
  price           Decimal         @db.Decimal(12, 4)
  unitAllowance   Decimal         @db.Decimal(12, 4) // GB, IP count, or port count depending on product billing unit
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  orderItems    OrderItem[]
  subscriptions Subscription[]

  @@index([productId])
}

// =============================================================
// Orders / Payments / Billing
// =============================================================

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

model Order {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status    OrderStatus @default(PENDING)
  subtotal  Decimal     @db.Decimal(12, 4)
  discount  Decimal     @default(0) @db.Decimal(12, 4)
  total     Decimal     @db.Decimal(12, 4)
  currency  String      @default("USD")
  couponId  String?
  coupon    Coupon?     @relation(fields: [couponId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  planId     String?
  plan       Plan?   @relation(fields: [planId], references: [id])
  quantity   Decimal @db.Decimal(12, 4)
  unitPrice  Decimal @db.Decimal(12, 4)
  totalPrice Decimal @db.Decimal(12, 4)
  metadata   Json?

  @@index([orderId])
  @@index([productId])
}

enum PaymentProvider {
  STRIPE
  MANUAL
  MOCK
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id                String          @id @default(uuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider          PaymentProvider
  providerPaymentId String?         @unique
  idempotencyKey    String          @unique
  amount            Decimal         @db.Decimal(12, 4)
  currency          String          @default("USD")
  status            PaymentStatus   @default(PENDING)
  rawPayload        Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([orderId])
  @@index([status])
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
  EXPIRED
}

model Subscription {
  id                     String             @id @default(uuid())
  userId                 String
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId              String
  product                Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  planId                 String
  plan                   Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status                 SubscriptionStatus @default(ACTIVE)
  providerSubscriptionId String?
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([userId])
  @@index([status])
}

/// Cash / account credit wallet — one row per customer.
model CustomerBalance {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cashBalance Decimal  @default(0) @db.Decimal(12, 4)
  updatedAt   DateTime @updatedAt
}

/// Per-product remaining allocation (GB, IPs, or ports depending on product's billing unit).
/// Stored in the smallest addressable unit for the product: bytes for GB products, whole units otherwise.
model ProductBalance {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  allocatedBytes BigInt   @default(0)
  remainingBytes BigInt   @default(0)
  allocatedUnits Decimal  @default(0) @db.Decimal(14, 4) // for IP/port-based products
  remainingUnits Decimal  @default(0) @db.Decimal(14, 4)
  updatedAt      DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
}

enum CouponType {
  PERCENT
  FIXED_AMOUNT
  FREE_GB
}

model Coupon {
  id                 String     @id @default(uuid())
  code               String     @unique
  type               CouponType
  value              Decimal    @db.Decimal(12, 4)
  appliesToProductId String?
  maxRedemptions     Int?
  timesRedeemed      Int        @default(0)
  active             Boolean    @default(true)
  expiresAt          DateTime?
  createdAt          DateTime   @default(now())

  orders Order[]
}

// =============================================================
// Upstream Providers (wholesale/reseller sources — never exposed to customers)
// =============================================================

enum GatewayStatus {
  HEALTHY
  DEGRADED
  OFFLINE
  MAINTENANCE
}

model Provider {
  id                 String        @id @default(uuid())
  name               String
  slug               String        @unique
  enabled            Boolean       @default(true)
  priority           Int           @default(100) // lower = preferred
  weight             Int           @default(100) // relative load-balancing weight
  apiBaseUrl         String?
  notes              String?
  healthStatus       GatewayStatus @default(HEALTHY)
  currentLatencyMs   Int?
  successRatePercent Decimal?      @db.Decimal(5, 2)
  monthlyUsageBytes  BigInt        @default(0)
  monthlyCost        Decimal       @default(0) @db.Decimal(14, 4)
  lastHealthCheckAt  DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  credentials   ProviderCredential[]
  products      ProviderProduct[]
  locations     ProviderLocation[]
  gatewayRoutes GatewayRoute[]
  proxySessions ProxySession[]
  usageRecords  UsageRecord[]

  @@index([enabled])
}

enum CredentialType {
  API_KEY
  BASIC_AUTH
  OAUTH
}

/// Encrypted upstream provider secrets. `encryptedValue` holds an AES-GCM
/// ciphertext (see lib/crypto/secrets.ts); plaintext is never persisted and
/// never returned by any API response.
model ProviderCredential {
  id             String         @id @default(uuid())
  providerId     String
  provider       Provider       @relation(fields: [providerId], references: [id], onDelete: Cascade)
  type           CredentialType
  label          String
  encryptedValue String
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  rotatedAt      DateTime?

  @@index([providerId])
}

model ProviderProduct {
  id          String   @id @default(uuid())
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  costPerGb   Decimal? @db.Decimal(12, 4)
  costPerIp   Decimal? @db.Decimal(12, 4)
  costPerPort Decimal? @db.Decimal(12, 4)
  active      Boolean  @default(true)

  @@unique([providerId, productId])
  @@index([productId])
}

model ProviderLocation {
  id            String   @id @default(uuid())
  providerId    String
  provider      Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  country       String
  region        String?
  city          String?
  capacityScore Int      @default(100)
  priority      Int      @default(100)

  @@index([providerId])
  @@index([country])
}

// =============================================================
// Gateways (customer-facing infrastructure we control)
// =============================================================

model Gateway {
  id                String        @id @default(uuid())
  name              String
  hostname          String        @unique
  ipAddress         String?
  region            String?
  status            GatewayStatus @default(HEALTHY)
  cpuPercent        Decimal?      @db.Decimal(5, 2)
  memoryPercent     Decimal?      @db.Decimal(5, 2)
  activeConnections Int           @default(0)
  bandwidthBps      BigInt        @default(0)
  latencyMs         Int?
  uptimeSeconds     BigInt        @default(0)
  lastHeartbeatAt   DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  routes           GatewayRoute[]
  healthChecks     GatewayHealth[]
  proxyCredentials CustomerProxyCredential[]
  proxySessions    ProxySession[]
  usageRecords     UsageRecord[]

  @@index([status])
}

/// Assigns a gateway to serve a given product using a given upstream provider,
/// with admin-controlled routing weight/priority. The routing engine reads
/// these rows to build its candidate set.
model GatewayRoute {
  id         String   @id @default(uuid())
  gatewayId  String
  gateway    Gateway  @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  priority   Int      @default(100)
  weight     Int      @default(100)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([gatewayId, providerId, productId])
  @@index([productId])
  @@index([gatewayId])
}

/// Heartbeat/health history reported by gateway agents.
model GatewayHealth {
  id                String        @id @default(uuid())
  gatewayId         String
  gateway           Gateway       @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  status            GatewayStatus
  cpuPercent        Decimal?      @db.Decimal(5, 2)
  memoryPercent     Decimal?      @db.Decimal(5, 2)
  activeConnections Int?
  bandwidthBps      BigInt?
  latencyMs         Int?
  recordedAt        DateTime      @default(now())

  @@index([gatewayId, recordedAt])
}

// =============================================================
// Customer proxy credentials & usage
// =============================================================

enum ProxyProtocol {
  HTTP
  HTTPS
  SOCKS5
}

enum ProxySessionType {
  ROTATING
  STICKY
}

enum CredentialStatus {
  ACTIVE
  DISABLED
  EXPIRED
}

/// Customer-facing proxy credential. Always bound to OUR gateway — never
/// contains upstream provider hostnames, usernames, or passwords.
model CustomerProxyCredential {
  id                  String           @id @default(uuid())
  userId              String
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId           String
  product             Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  gatewayId           String
  gateway             Gateway          @relation(fields: [gatewayId], references: [id], onDelete: Restrict)
  label               String?
  username            String           @unique
  passwordEnc         String // encrypted, decrypted only to display once to the owning customer
  protocol            ProxyProtocol
  sessionType         ProxySessionType
  country             String?
  region              String?
  city                String?
  sessionDurationMins Int?
  status              CredentialStatus @default(ACTIVE)
  createdAt           DateTime         @default(now())
  expiresAt           DateTime?
  lastUsedAt          DateTime?
  revokedAt           DateTime?
  revokedReason       String?

  sessions     ProxySession[]
  usageRecords UsageRecord[]

  @@index([userId])
  @@index([gatewayId])
  @@index([status])
}

/// A single upstream-routed connection/session instance behind a customer credential.
model ProxySession {
  id                 String                  @id @default(uuid())
  credentialId       String
  credential         CustomerProxyCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  gatewayId          String
  gateway            Gateway                 @relation(fields: [gatewayId], references: [id], onDelete: Restrict)
  providerId         String
  provider           Provider                @relation(fields: [providerId], references: [id], onDelete: Restrict)
  upstreamSessionRef String? // opaque reference only, never provider credentials
  exitCountry        String?
  exitIp             String?
  startedAt          DateTime                @default(now())
  endedAt            DateTime?
  bytesUploaded      BigInt                  @default(0)
  bytesDownloaded    BigInt                  @default(0)

  @@index([credentialId])
  @@index([gatewayId])
  @@index([startedAt])
}

/// Immutable bandwidth accounting ledger. `dedupeKey` guarantees a given
/// upstream usage event can only ever be applied to a customer's balance once.
model UsageRecord {
  id              String                   @id @default(uuid())
  userId          String
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId       String
  product         Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  gatewayId       String
  gateway         Gateway                  @relation(fields: [gatewayId], references: [id], onDelete: Restrict)
  providerId      String
  provider        Provider                 @relation(fields: [providerId], references: [id], onDelete: Restrict)
  credentialId    String?
  credential      CustomerProxyCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  dedupeKey       String                   @unique
  bytesUploaded   BigInt                   @default(0)
  bytesDownloaded BigInt                   @default(0)
  totalBytes      BigInt
  requestCount    Int                      @default(0)
  occurredAt      DateTime
  createdAt       DateTime                 @default(now())

  @@index([userId, occurredAt])
  @@index([productId, occurredAt])
  @@index([gatewayId])
  @@index([providerId])
}

// =============================================================
// Support / Abuse Management
// =============================================================

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SupportTicket {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  category  String?
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(MEDIUM)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  messages SupportTicketMessage[]

  @@index([userId])
  @@index([status])
}

model SupportTicketMessage {
  id         String        @id @default(uuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  author     User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  isInternal Boolean       @default(false)
  body       String
  createdAt  DateTime      @default(now())

  @@index([ticketId])
}

enum AbuseReportStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

model AbuseReport {
  id           String            @id @default(uuid())
  userId       String?
  user         User?             @relation("AbuseReportsForUser", fields: [userId], references: [id], onDelete: SetNull)
  credentialId String?
  gatewayId    String?
  reportedBy   String?
  type         String
  description  String
  status       AbuseReportStatus @default(OPEN)
  createdAt    DateTime          @default(now())
  resolvedAt   DateTime?

  @@index([userId])
  @@index([status])
}

model AccountNote {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("AccountNotesForUser", fields: [userId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("AccountNotesByAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  note      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// =============================================================
// Audit / System
// =============================================================

model AuditLog {
  id         String    @id @default(uuid())
  actorId    String?
  actor      User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole  UserRole?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}

/**
 * Per-destination override of the global gateway tuning defaults (see
 * gateway-tuning.ts) — e.g. a site known to be more reputation-sensitive
 * can get more quality-check attempts, or a latency-sensitive one can have
 * rotation-time checking turned off, without changing behavior for every
 * other target. Any field left null falls back to the live global default
 * for that field rather than a fixed value, so a rule can override just
 * one knob without having to pin every other one.
 *
 * Matched by hostname against `pattern`: an exact hostname match wins over
 * a suffix/wildcard match (see gateway-tuning.ts's matchSiteRule) — "*"
 * prefix means "this domain and all its subdomains."
 */
model SiteRule {
  id                               String   @id @default(uuid())
  /** e.g. "target.com" (exact) or "*.target.com" (that domain + subdomains). */
  pattern                          String   @unique
  label                            String?
  enabled                          Boolean  @default(true)
  qualityCheckEnabled              Boolean?
  qualityCheckOnRotation           Boolean?
  issuanceQualityCheckMaxAttempts  Int?
  rotationQualityCheckMaxAttempts  Int?
  defaultStickyWindowMins          Int?

  // ---- Destination-aware routing profile -------------------------------
  //
  // Keyed by Provider.slug (a plain string, not a foreign key) — matches
  // how the rest of the codebase already refers to upstream pools/providers
  // (gateway-agent's logs, classifyExitIp, getProviderAdapter all key off
  // the slug already). preferredProviderSlug/fallbackProviderSlugs are
  // preferences the health-scoring router (see routing-engine.ts) weighs
  // alongside live per-destination scores — not a hard override — so a
  // preferred pool that's currently scoring badly for this destination can
  // still lose to a fallback, same philosophy as the existing global
  // selectRoute()'s priority/weight being inputs to a score, not absolutes.
  /** Preferred upstream pool for this destination, by Provider.slug. Null = no preference, global routing applies. */
  preferredProviderSlug            String?
  /** Ordered fallback pools if the preferred one is unhealthy/unavailable for this destination, by Provider.slug. */
  fallbackProviderSlugs            String[] @default([])
  /** ISO country code to prefer for this destination's exit IPs, e.g. "US". Null = no preference. */
  region                           String?
  /** Per-destination connection timeout override, in ms. Null = gateway-agent's default (30s). */
  connectionTimeoutMs              Int?
  /** Max upstream-selection attempts before giving up on a connection for this destination. Null = existing single-retry default. */
  maxConnectionAttempts            Int?
  /** Caps concurrent active sessions for this destination across all credentials. Null = no limit. */
  concurrencyLimit                 Int?
  /** Relative weight this destination's traffic gets versus others when providers are shared/contended. Null = default weight (100). */
  routingWeight                    Int?

  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  @@index([enabled])
}

/**
 * One row per completed (or failed) CONNECT/tunnel attempt, reported by
 * gateway-agent in small periodic batches (see
 * POST /api/gateway-control/connection-stats) — the raw source of truth
 * behind both the admin dashboard's per-destination/per-pool stats and the
 * rolling health scores routing-engine.ts reads from Redis (see
 * connection-health.ts; this table is never queried on the live routing
 * path, only by the background scorer and the admin stats UI).
 *
 * destinationPattern is the SiteRule pattern this event's hostname matched
 * (or the literal string "default" if no rule matched) — grouping at the
 * SAME granularity SiteRule/routing decisions use, rather than raw
 * hostnames, so a site with many subdomains doesn't fragment its stats
 * across dozens of buckets. providerSlug identifies the upstream pool,
 * same slug convention as SiteRule's provider fields above.
 */
model ConnectionEvent {
  id                 String   @id @default(uuid())
  destinationPattern String
  providerSlug       String
  /** True if the CONNECT tunnel was established (upstream returned 200) — independent of what happened after, per the "no HTTP replay after tunnel establishment" rule; this table only ever records tunnel-establishment outcomes. */
  success            Boolean
  /** One of TIMEOUT | DNS | TCP | TLS | UPSTREAM_REJECTED | OTHER — mirrors gateway-agent's existing classifyError() classes plus a TLS split where observable. Null when success is true. */
  errorClass         String?
  connectLatencyMs   Int
  bytesUploaded      BigInt   @default(0)
  bytesDownloaded    BigInt   @default(0)
  /** The gateway-agent-reported session id (same id ProxySession/logEvent
   * already use) this connection belonged to. Not a foreign key — sessions
   * aren't destination-scoped, so this is only ever used to COUNT distinct
   * recent sessions per destination+pool for the "active sessions" stat,
   * never joined against ProxySession directly. Nullable since a
   * credential-resolve failure (407/502 before a session was ever
   * assigned) has no session to attribute the event to. */
  sessionId          String?
  occurredAt         DateTime @default(now())

  @@index([destinationPattern, providerSlug, occurredAt])
  @@index([occurredAt])
}
