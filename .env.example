# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---------------------------------------------------------
# PostgreSQL connection string. Matches docker-compose.yml by default.
DATABASE_URL="postgresql://proxygrid:proxygrid_dev_password@localhost:5432/proxygrid?schema=public"
# Optional separate connection for migrations (e.g. when using a pooler like
# PgBouncer for DATABASE_URL). Defaults to DATABASE_URL if unset.
DIRECT_URL="postgresql://proxygrid:proxygrid_dev_password@localhost:5432/proxygrid?schema=public"

# --- Redis (rate limiting, caching) ------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Auth ---------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-base64-secret"

# 32-byte base64 key used to encrypt upstream provider credentials and
# customer proxy passwords at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY="replace-with-a-random-32-byte-base64-key"

# --- Brand (single source of truth for naming across the app) ----------
NEXT_PUBLIC_BRAND_NAME="ProxyGrid"
NEXT_PUBLIC_BRAND_SHORT_NAME="ProxyGrid"
NEXT_PUBLIC_BRAND_DOMAIN="proxygrid.com"
NEXT_PUBLIC_SUPPORT_EMAIL="support@proxygrid.com"
NEXT_PUBLIC_LEGAL_EMAIL="legal@proxygrid.com"
NEXT_PUBLIC_BRAND_TWITTER="@proxygrid"

# --- Billing (TODO: wired up in a later phase) --------------------------
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PUBLISHABLE_KEY=""

# --- Email (TODO: wired up in a later phase; dev mode logs to console) -
