# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---------------------------------------------------------
# PostgreSQL connection string. Matches docker-compose.yml by default.
DATABASE_URL="postgresql://finestproxies:finestproxies_dev_password@localhost:5432/finestproxies?schema=public"
# Optional separate connection for migrations (e.g. when using a pooler like
# PgBouncer for DATABASE_URL). Defaults to DATABASE_URL if unset.
DIRECT_URL="postgresql://finestproxies:finestproxies_dev_password@localhost:5432/finestproxies?schema=public"

# --- Redis (rate limiting, caching) ------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Auth ---------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-base64-secret"

# 32-byte base64 key used to encrypt upstream provider credentials and
# customer proxy passwords at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY="replace-with-a-random-32-byte-base64-key"

# --- Gateway Control API (heartbeat + usage ingestion from gateway agents) --
# Shared bearer secret for dev/single-fleet use. See the TODO in
# src/lib/auth/require-gateway-agent.ts for the per-gateway-credential plan.
GATEWAY_AGENT_SECRET="replace-with-a-random-secret"

# --- Brand (single source of truth for naming across the app) ----------
NEXT_PUBLIC_BRAND_NAME="Finest Proxies"
NEXT_PUBLIC_BRAND_SHORT_NAME="Finest Proxies"
NEXT_PUBLIC_BRAND_DOMAIN="finestproxies.com"
NEXT_PUBLIC_SUPPORT_EMAIL="support@finestproxies.com"
NEXT_PUBLIC_LEGAL_EMAIL="legal@finestproxies.com"
NEXT_PUBLIC_BRAND_TWITTER="@finestproxies"

# --- Billing (TODO: wired up in a later phase) --------------------------
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PUBLISHABLE_KEY=""

