# Copy to .env.production on the VPS and fill in real values.
# Used by docker-compose.prod.yml. Never commit the filled-in version.

# --- Database ---------------------------------------------------------
# Pick a real password and use the SAME one in both places below —
# POSTGRES_PASSWORD (read by the postgres container to set up the user)
# and inside DATABASE_URL (read by the app to connect to it). The host is
# "postgres", the service name in docker-compose.prod.yml, not localhost.
#
# connection_limit matters more than it looks like it should: Prisma
# defaults to num_physical_cpus * 2 + 1 when it's not set explicitly, which
# on a small VPS can be as low as 3-5 — nothing to do with how many
# customers actually hit the gateway concurrently. Confirmed in production
# (Aug 2026): 15 simultaneous credential resolves (one small customer batch
# testing at once) queued behind that default pool, tailing out to 4-5s for
# the last few to get a free connection, while sequential single requests
# were consistently under 1s. Set explicitly and sized for real concurrent
# gateway traffic, not CPU count — Postgres's own max_connections (default
# 100, confirm with `SHOW max_connections;`) is the actual ceiling to stay
# under, accounting for Postgres's own reserved/admin connections too.
POSTGRES_USER="finestproxies"
POSTGRES_PASSWORD="replace-with-a-strong-password"
POSTGRES_DB="finestproxies"
DATABASE_URL="postgresql://finestproxies:replace-with-a-strong-password@postgres:5432/finestproxies?schema=public&connection_limit=40&pool_timeout=20"
DIRECT_URL="postgresql://finestproxies:replace-with-a-strong-password@postgres:5432/finestproxies?schema=public"

# --- Redis --------------------------------------------------------------
# Host is "redis", the service name in docker-compose.prod.yml.
REDIS_URL="redis://redis:6379"

# --- Auth -----------------------------------------------------------------
NEXTAUTH_URL="https://finestproxies.com"
# Generate with: openssl rand -base64 32  (or the node one-liner in the README)
NEXTAUTH_SECRET="replace-with-a-random-32-byte-base64-secret"
SECRETS_ENCRYPTION_KEY="replace-with-a-random-32-byte-base64-key"
GATEWAY_AGENT_SECRET="replace-with-a-random-secret"

# --- Stripe (optional) -----------------------------------------------------
# Leave both unset and purchases fall back to the mock payment provider —
# instantly "paid," no real card charged. Not something you want live in
# production once you're actually selling.
# STRIPE_SECRET_KEY=""
# From the Stripe Dashboard webhook endpoint you point at
# https://<your-domain>/api/webhooks/stripe — needed to verify events are
# genuinely from Stripe before crediting anyone's balance.
# STRIPE_WEBHOOK_SECRET=""

# --- Discord OAuth (optional) --------------------------------------------
# DISCORD_CLIENT_ID=""
# DISCORD_CLIENT_SECRET=""
# Users who log in with Discord and hold this role in this server are
# auto-promoted to ADMIN on sign-in (never auto-demoted — revoke admin
# access from /admin/customers instead). Leave both unset to disable this
# entirely; Discord logins then always create/sign in as CUSTOMER.
# DISCORD_ADMIN_SERVER_ID=""
# DISCORD_ADMIN_ROLE_ID=""

# --- Pre-launch site gate (optional) -------------------------------------
# When set, every page redirects to /coming-soon until the visitor enters
# this password. Unlike NEXT_PUBLIC_* vars above, this one IS read live at
# request time (checked in middleware), so it works correctly with this
# Docker setup. Remove this line and redeploy to open the site — that's
# the actual "launch" step.
# SITE_PASSWORD=""

# --- Brand ----------------------------------------------------------------
# NOTE: NEXT_PUBLIC_* vars are baked into the client bundle at build time,
# not read at container startup — since docker-compose builds the image
# before this file is available to it, these vars here have NO EFFECT.
# The defaults already hardcoded in src/lib/config/brand.ts (Finest
# Proxies / finestproxies.com) are what actually ships. To change the
# brand for a Docker deployment, edit that file directly, don't rely on
# these env vars — they're listed here only for parity with .env.example.
# NEXT_PUBLIC_BRAND_NAME="Finest Proxies"
# NEXT_PUBLIC_BRAND_DOMAIN="finestproxies.com"
